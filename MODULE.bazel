module(
    name = "xsigma_serialization",
    version = "2.0.0",
)

bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "rules_pkg", version = "1.0.1")

# Testing/Cxx uses GoogleTest, via bzlmod rather than a vendored ThirdParty/
# submodule (unlike Parallel/LinearAlgebra/Logging, Serialization does not
# vendor googletest itself). CMakeLists.txt pins the same project via
# FetchContent to v1.14.0 (see the SERIALIZATION_BUILD_TESTING block); the
# Bazel Central Registry does not publish that exact tag, so this pins the
# closest available release instead for parity in spirit.
bazel_dep(name = "googletest", version = "1.15.2", repo_name = "com_google_googletest")
