# =============================================================================
# Serialization Library Tests BUILD Configuration
# =============================================================================
# Test target for the Serialization library using GoogleTest.
# Equivalent to Testing/Cxx/CMakeLists.txt's SerializationCxxTests.
# =============================================================================

load("@rules_cc//cc:defs.bzl", "cc_test")
load("//bazel:serialization.bzl", "serialization_copts", "serialization_defines", "serialization_linkopts")

package(default_visibility = ["//visibility:public"])

cc_test(
    name = "SerializationCxxTests",
    size = "large",
    timeout = "long",
    srcs = glob(["Test*.cpp"], allow_empty = True) + ["TestSupport.h"],
    copts = serialization_copts(),
    defines = serialization_defines() + [
        "SERIALIZATION_GOOGLE_TEST",
        "USE_GTEST",
        "_VARIADIC_MAX=10",
    ],
    includes = ["."],
    linkopts = serialization_linkopts(),
    deps = [
        "//:Serialization",
        "//:SerializationBinary",
        "//:SerializationCore",
        "//:SerializationJson",
        "//:SerializationXml",
        "@com_google_googletest//:gtest",
        "@com_google_googletest//:gtest_main",
    ],
)
